        <mxCell id="title" value="Interrelationships &amp; Communication Structures&#xa;Choose a topology to fit the task, autonomy, robustness, and communication budget" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#18343B;" vertex="1" parent="1"><mxGeometry x="44" y="22" width="900" height="72" as="geometry" /></mxCell>
        <mxCell id="p1" value="1. Single Agent&#xa;One autonomous unit; no peer exchange" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=16;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="36" y="112" width="322" height="270" as="geometry" /></mxCell>
        <mxCell id="p2" value="2. Network&#xa;Peers communicate directly" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=16;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="379" y="112" width="322" height="270" as="geometry" /></mxCell>
        <mxCell id="p3" value="3. Supervisor&#xa;Coordinator delegates and gathers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=16;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="722" y="112" width="322" height="270" as="geometry" /></mxCell>
        <mxCell id="p4" value="4. Supervisor as a Tool&#xa;Agents consult a shared service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=16;verticalAlign=top;spacingTop=14;" vertex="1" parent="1"><mxGeometry x="36" y="408" width="322" height="270" as="geometry" /></mxCell>
