        <mxCell id="human" value="Human review / escalation&#xa;for high-risk, ambiguous, or flagged cases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E8;strokeColor=#D99B76;fontColor=#18343B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="510" y="352" width="310" height="78" as="geometry" /></mxCell>
        <mxCell id="escalate" value="flag" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52636B;strokeWidth=2;dashed=1;" edge="1" parent="1" source="outputSafeguards" target="human"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="observability" value="Monitoring, testing, and privacy-aware observability span every layer&#xa;Log decisions, tool outcomes, errors, and metrics; minimize/redact sensitive data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18343B;strokeColor=#18343B;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="190" y="464" width="804" height="54" as="geometry" /></mxCell>
        <mxCell id="caption" value="Defense in depth reduces risk; no individual filter guarantees safe or correct behavior." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=13;fontColor=#52636B;" vertex="1" parent="1"><mxGeometry x="160" y="535" width="840" height="28" as="geometry" /></mxCell>
