<mxfile host="app.diagrams.net" type="device">
  <diagram id="guardrails-defense-in-depth" name="Guardrails Defense in Depth">
    <mxGraphModel page="1" pageWidth="1180" pageHeight="650" adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Guardrails: layered boundaries, not a safety guarantee&#xa;Conceptual defense in depth; policy, tool identity and native moderation are separate console variants." style="text;html=1;align=left;whiteSpace=wrap;fontSize=24;fontColor=#18343B;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1100" height="80" as="geometry"/></mxCell>
        <mxCell id="input" value="Request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontSize=16;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="inputSafeguards" value="Input policy&#xa;validate / admit / block" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EDF7;strokeColor=#9AA8C2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="240" y="160" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="agent" value="Agent&#xa;proposes work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18343B;fontColor=#FFFFFF;strokeColor=#18343B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="500" y="160" width="160" height="90" as="geometry"/></mxCell>
        <mxCell id="outputSafeguards" value="Output checks&#xa;release / block / review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E7;strokeColor=#D58C86;fontSize=16;" vertex="1" parent="1"><mxGeometry x="740" y="160" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="user" value="Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1000" y="160" width="140" height="90" as="geometry"/></mxCell>
        <mxCell id="toolBoundary" value="Tool boundary&#xa;allowlist + validate arguments&#xa;enforce authorization in code" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E8;strokeColor=#D99B76;fontSize=15;" vertex="1" parent="1"><mxGeometry x="500" y="360" width="240" height="110" as="geometry"/></mxCell>
        <mxCell id="human" value="Blocked / needs review&#xa;no release or action&#xa;until authorized" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E7;strokeColor=#D58C86;fontSize=16;" vertex="1" parent="1"><mxGeometry x="240" y="360" width="180" height="110" as="geometry"/></mxCell>
        <mxCell id="tool" value="Permitted tool&#xa;execute + observe" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EDF7;strokeColor=#9AA8C2;fontSize=16;" vertex="1" parent="1"><mxGeometry x="860" y="370" width="180" height="90" as="geometry"/></mxCell>
        <mxCell id="observability" value="Privacy-aware tracing and testing span all boundaries. Prompts do not grant authority.&#xa;Output filtering and review workflows require their own implementation; uncertainty is not acceptance." style="text;whiteSpace=wrap;html=1;fontColor=#18343B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="180" y="550" width="820" height="70" as="geometry"/></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="input" target="inputSafeguards"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="Admitted" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="inputSafeguards" target="agent"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="Final answer" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="outputSafeguards"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="Pass" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="outputSafeguards" target="user"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="Blocked / uncertain" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="inputSafeguards" target="human"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="Optional tool call" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="agent" target="toolBoundary"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="Authorized" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="toolBoundary" target="tool"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="Denied" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="toolBoundary" target="human"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="Result to agent via host" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=1;exitY=0.5;entryX=0.5;entryY=0;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="tool" target="agent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1160" y="415"/><mxPoint x="1160" y="120"/><mxPoint x="580" y="120"/></Array></mxGeometry></mxCell>
        <mxCell id="e10" value="Flagged: stop / review" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeWidth=2;exitX=0.5;exitY=1;entryX=0.5;entryY=1;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="outputSafeguards" target="human"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="830" y="510"/><mxPoint x="330" y="510"/></Array></mxGeometry></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
