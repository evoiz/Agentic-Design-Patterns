        <mxCell id="title" value="Guardrails: layered, not a single prompt&#xa;Each boundary catches different risks; deterministic policy controls access and consequential actions" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#18343B;" vertex="1" parent="1"><mxGeometry x="44" y="22" width="1000" height="62" as="geometry" /></mxCell>
        <mxCell id="input" value="Input&#xa;request + data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontColor=#18343B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="34" y="175" width="126" height="96" as="geometry" /></mxCell>
        <mxCell id="inputSafeguards" value="Input safeguards&#xa;&#xa;validate / sanitize&#xa;PII minimization&#xa;moderation / scope checks&#xa;block, redact, or continue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EDF7;strokeColor=#9AA8C2;fontColor=#18343B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="190" y="144" width="185" height="158" as="geometry" /></mxCell>
        <mxCell id="agent" value="AGENT&#xa;&#xa;Behavioral policy&#xa;instructions guide;&#xa;they do not authorize" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18343B;strokeColor=#18343B;fontColor=#FFFFFF;fontSize=15;" vertex="1" parent="1"><mxGeometry x="406" y="144" width="178" height="158" as="geometry" /></mxCell>
        <mxCell id="toolBoundary" value="Tool boundary&#xa;&#xa;allowlist + least privilege&#xa;validate arguments&#xa;enforce authorization&#xa;code / gateway decides" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0E8;strokeColor=#D99B76;fontColor=#18343B;fontSize=14;" vertex="1" parent="1"><mxGeometry x="615" y="144" width="178" height="158" as="geometry" /></mxCell>
