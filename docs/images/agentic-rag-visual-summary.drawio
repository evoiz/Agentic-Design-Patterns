<mxfile host="app.diagrams.net" modified="2026-11-05T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="agentic-rag" name="Agentic RAG Workflow">
    <mxGraphModel dx="1120" dy="590" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="590" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Agentic RAG: retrieve, assess, and fill knowledge gaps&#xa;The agent reasons over evidence instead of passing the first retrieval results straight to generation" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#18343B;" vertex="1" parent="1"><mxGeometry x="44" y="22" width="1000" height="72" as="geometry" /></mxCell>
        <mxCell id="query" value="User query&#xa;question / goal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontColor=#18343B;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="166" width="145" height="110" as="geometry" /></mxCell>
        <mxCell id="retrieve" value="Retrieve&#xa;&#xa;chunked index&#xa;hybrid search / rerank&#xa;candidate sources + metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EDF7;strokeColor=#9AA8C2;fontColor=#18343B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="215" y="146" width="190" height="150" as="geometry" /></mxCell>
        <mxCell id="assess" value="AGENT ASSESSMENT&#xa;&#xa;validate source, freshness, authority, relevance&#xa;check conflicts and coverage&#xa;decompose into subqueries if needed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18343B;strokeColor=#18343B;fontColor=#FFFFFF;fontSize=14;" vertex="1" parent="1"><mxGeometry x="445" y="126" width="205" height="190" as="geometry" /></mxCell>
        <mxCell id="decision" value="Sufficient,&#xa;reliable evidence?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF0E8;strokeColor=#D99B76;fontColor=#18343B;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="660" y="154" width="150" height="132" as="geometry" /></mxCell>
        <mxCell id="synthesize" value="Synthesize answer&#xa;cite evidence; disclose gaps&#xa;or abstain if unresolved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontColor=#18343B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="870" y="166" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="gap" value="Knowledge gap or conflict&#xa;form subqueries; use internal or web search&#xa;then validate the new evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE8E7;strokeColor=#D58C86;fontColor=#18343B;fontSize=15;" vertex="1" parent="1"><mxGeometry x="560" y="385" width="290" height="92" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52636B;strokeWidth=2;" edge="1" parent="1" source="query" target="retrieve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52636B;strokeWidth=2;" edge="1" parent="1" source="retrieve" target="assess"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52636B;strokeWidth=2;" edge="1" parent="1" source="assess" target="decision"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="yes" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#52636B;strokeWidth=2;" edge="1" parent="1" source="decision" target="synthesize"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="no" value="No: inspect gap + budget" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#52636B;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="decision" target="gap"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="loop" value="Search again only while budget remains" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeColor=#52636B;strokeWidth=2;dashed=1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gap" target="retrieve"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="560" y="515" /><mxPoint x="310" y="515" /></Array></mxGeometry></mxCell>
        <mxCell id="exhausted" value="Exhausted / no reliable source: abstain" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;strokeColor=#52636B;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gap" target="synthesize"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="caption" value="Conceptual retrieval loop. The runnable demo uses a bounded local-corpus search tool, not hybrid indexing or web gap search." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#52636B;" vertex="1" parent="1"><mxGeometry x="100" y="540" width="920" height="32" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
