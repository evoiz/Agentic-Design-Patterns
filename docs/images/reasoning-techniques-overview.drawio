<mxfile host="app.diagrams.net" modified="2026-11-05T00:00:00.000Z" agent="GitHub Copilot" version="24.7.17" type="device">
  <diagram id="reasoning-techniques" name="Reasoning Techniques Overview">
    <mxGraphModel dx="1080" dy="1010" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1080" pageHeight="1010" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mainTitle" value="Reasoning Techniques: illustrated overview&#xa;Different ways to decompose, explore, verify, act, collaborate, or spend inference-time compute" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#18343B;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="1000" height="62" as="geometry" /></mxCell>
        <mxCell id="cotCard" value="1. Chain-of-Thought (CoT)&#xa;&#xa;Prompt -> Step 1 -> Step 2 -> Answer&#xa;&#xa;Decompose into an ordered path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2F1EE;strokeColor=#76A99E;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="100" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="totCard" value="2. Tree-of-Thought (ToT)&#xa;&#xa;             Start&#xa;        /     |     \\&#xa;      A       B       C&#xa;       \\     /       |&#xa;         choose / backtrack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="377" y="100" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="selfCard" value="3. Self-correction&#xa;&#xa;Draft -> Critique -> Revise&#xa;  ^_________________|&#xa;&#xa;Review against criteria" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="726" y="100" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="palCard" value="4. Program-Aided Reasoning (PAL)&#xa;&#xa;LLM writes code -> Execute -> Result&#xa;&#xa;Use deterministic computation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="310" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="rlvrCard" value="5. RL with Verifiable Rewards (RLVR)&#xa;&#xa;Sample -> Verify -> Reward -> Update&#xa;                     ^____________|&#xa;&#xa;Train against checkable outcomes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="377" y="310" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="reactCard" value="6. ReAct: Reason + Act&#xa;&#xa;Thought -> Action -> Observation&#xa;   ^_______________________|&#xa;&#xa;Tool results inform the next step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="726" y="310" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="codCard" value="7. Chain of Debates (CoD)&#xa;&#xa;Model A -> Model B -> Synthesis&#xa;         critique / counterpoint&#xa;&#xa;Exchange arguments in sequence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="520" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="godCard" value="8. Graph of Debates (GoD)&#xa;&#xa;Claim A ---- supports ---- Claim B&#xa;    \\                       /&#xa;     refutes          evidence&#xa;Arguments branch and merge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="377" y="520" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="massCard" value="9. MASS: Multi-Agent System Search&#xa;&#xa;Block prompts -> Topology -> Workflow prompt&#xa;&#xa;Optimize components, connections, system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="726" y="520" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="deepCard" value="10. Deep Research / DeepSearch&#xa;&#xa;Plan -> Search -> Reflect -> Follow up&#xa;                     ^___________|&#xa;              -> Cited report&#xa;Research iteratively and fill gaps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="28" y="730" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="scaleCard" value="11. Inference-time scaling&#xa;&#xa;More test-time compute -> possible quality gain&#xa;Returns vary by task; latency / cost rise&#xa;&#xa;Not a guarantee of better results" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="377" y="730" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="thinkingCard" value="What do agents think?&#xa;&#xa;Thought -> Action -> Observation&#xa;   ^_______________________|&#xa;&#xa;An operational loop, not a faithful transcript" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DEDB;fontColor=#18343B;fontSize=15;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="726" y="730" width="326" height="190" as="geometry" /></mxCell>
        <mxCell id="footer" value="Reasoning methods add structure or compute, not guaranteed correctness; evaluate against task-specific criteria." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;fontColor=#52636B;" vertex="1" parent="1"><mxGeometry x="90" y="948" width="900" height="32" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
